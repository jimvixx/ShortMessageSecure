default_platform(:android)

require "shellwords"
require "base64"
require "digest"

def decode_keystore!
  keystore_base64 = ENV["ANDROID_KEYSTORE_BASE64"]
  UI.user_error!("Missing ANDROID_KEYSTORE_BASE64") if keystore_base64.to_s.empty?

  File.binwrite("smsecure-release.keystore", Base64.decode64(keystore_base64))
end

def write_keystore_properties!
  store_password = ENV["SIGNING_STORE_PASSWORD"]
  key_alias = ENV["SIGNING_KEY_ALIAS"]
  key_password = ENV["SIGNING_KEY_PASSWORD"]

  UI.user_error!("Missing SIGNING_STORE_PASSWORD") if store_password.to_s.empty?
  UI.user_error!("Missing SIGNING_KEY_ALIAS") if key_alias.to_s.empty?
  UI.user_error!("Missing SIGNING_KEY_PASSWORD") if key_password.to_s.empty?

  File.write("keystore.properties", <<~PROPS)
    storeFile=smsecure-release.keystore
    storePassword=#{store_password}
    keyAlias=#{key_alias}
    keyPassword=#{key_password}
  PROPS
end

def find_unsigned_apk!
  apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]

  UI.message("Gradle APK output: #{apk_path}")

  UI.user_error!("No APK output path returned by Gradle") if apk_path.to_s.empty?
  UI.user_error!("Expected unsigned APK, got: #{apk_path}") unless apk_path.end_with?("-unsigned.apk")

  apk_path
end

def find_latest_build_tools_dir!
  android_home = ENV["ANDROID_HOME"]
  android_sdk_root = ENV["ANDROID_SDK_ROOT"]

  candidates = []

  if !android_home.to_s.empty?
    candidates.concat(Dir.glob(File.join(android_home, "build-tools", "*")))
  end

  if !android_sdk_root.to_s.empty?
    candidates.concat(Dir.glob(File.join(android_sdk_root, "build-tools", "*")))
  end

  build_tools_dir = candidates.uniq.sort.last
  UI.user_error!("Android build-tools not found") if build_tools_dir.to_s.empty?

  build_tools_dir
end

def sign_apk!(unsigned_apk_path)
  build_tools_dir = find_latest_build_tools_dir!

  apksigner = File.join(build_tools_dir, "apksigner")
  zipalign = File.join(build_tools_dir, "zipalign")

  UI.user_error!("apksigner not found at #{apksigner}") unless File.exist?(apksigner)
  UI.user_error!("zipalign not found at #{zipalign}") unless File.exist?(zipalign)

  aligned_apk_path = unsigned_apk_path.sub(/-unsigned\.apk\z/, "-aligned.apk")
  signed_apk_path = unsigned_apk_path.sub(/-unsigned\.apk\z/, ".apk")

  sh(
    "#{zipalign.shellescape} -f -p 4 " \
    "#{unsigned_apk_path.shellescape} " \
    "#{aligned_apk_path.shellescape}"
  )

  sh(
    "#{apksigner.shellescape} sign " \
    "--ks smsecure-release.keystore " \
    "--ks-key-alias #{ENV['SIGNING_KEY_ALIAS'].shellescape} " \
    "--ks-pass env:SIGNING_STORE_PASSWORD " \
    "--key-pass env:SIGNING_KEY_PASSWORD " \
    "--out #{signed_apk_path.shellescape} " \
    "#{aligned_apk_path.shellescape}"
  )

  sh("#{apksigner.shellescape} verify --verbose #{signed_apk_path.shellescape}")

  signed_apk_path
end

def detect_release_tag!
  if !ENV["MANUAL_TAG_NAME"].to_s.empty?
    ENV["MANUAL_TAG_NAME"]
  elsif ENV["GITHUB_REF_TYPE"] == "tag" && !ENV["GITHUB_REF_NAME"].to_s.empty?
    ENV["GITHUB_REF_NAME"]
  else
    last_git_tag
  end
end

def normalize_apk_name!(signed_apk_path, tag_name)
  final_apk_name = "SMSecure-#{tag_name}.apk"
  final_apk_path = File.join(File.dirname(signed_apk_path), final_apk_name)

  File.delete(final_apk_path) if File.exist?(final_apk_path)
  sh("mv #{signed_apk_path.shellescape} #{final_apk_path.shellescape}")

  final_apk_path
end

def write_sha256_sums!(apk_path)
  apk_dir = File.dirname(apk_path)
  apk_name = File.basename(apk_path)
  sha256 = Digest::SHA256.file(apk_path).hexdigest
  checksums_path = File.join(apk_dir, "SHA256SUMS.txt")

  File.write(checksums_path, "#{sha256}  #{apk_name}\n")

  checksums_path
end

def signing_certificate_sha256
  "FA:3A:00:75:00:6D:56:DD:5E:7B:F9:FA:5F:83:55:63:BF:7D:71:6A:82:19:7A:28:96:17:14:D0:6F:72:AE:01"
end

def build_release_notes(tag_name, checksums_path)
  sha_text = File.read(checksums_path).strip

  <<~NOTES
    ## Downloads

    - `#{File.basename(checksums_path.sub(/SHA256SUMS\.txt\z/, "#{tag_name}.apk"))}`  
    - `SHA256SUMS.txt`

    ## SHA-256

    ```text
    #{sha_text}
    ```

    ## Verification

    Verify APK checksum:

    ```bash
    sha256sum -c SHA256SUMS.txt
    ```

    Verify signing certificate fingerprint:

    ```bash
    apksigner verify --print-certs SMSecure-#{tag_name}.apk
    ```

    Official signing certificate SHA-256:

    ```text
    #{signing_certificate_sha256}
    ```

    Google Play Protect may warn because SMSecure is distributed outside Google Play.
  NOTES
end

platform :android do
  desc "CI verification: build debug APK and run lint"
  lane :ci do
    gradle(task: "assembleDebug")
    gradle(task: "lintDebug")
  end

  desc "Build signed release APK, generate SHA256SUMS.txt and publish a GitHub release"
  lane :release do
    UI.message("STORE_PASSWORD set? #{!ENV['SIGNING_STORE_PASSWORD'].to_s.empty?}")
    UI.message("KEY_ALIAS: #{ENV['SIGNING_KEY_ALIAS']}")
    UI.message("KEY_PASSWORD set? #{!ENV['SIGNING_KEY_PASSWORD'].to_s.empty?}")
    UI.message("KEYSTORE base64 size: #{ENV['ANDROID_KEYSTORE_BASE64']&.length}")

    decode_keystore!
    write_keystore_properties!

    gradle(task: "assembleRelease")

    unsigned_apk_path = find_unsigned_apk!
    signed_apk_path = sign_apk!(unsigned_apk_path)

    sh("git fetch --tags --force")

    tag_name = detect_release_tag!
    signed_apk_path = normalize_apk_name!(signed_apk_path, tag_name)
    checksums_path = write_sha256_sums!(signed_apk_path)

    changelog = changelog_from_git_commits(
      merge_commit_filtering: "exclude_merges"
    ).to_s.strip

    release_notes = build_release_notes(tag_name, checksums_path)
    full_description =
      if changelog.empty?
        release_notes
      else
        "#{changelog}\n\n---\n\n#{release_notes}"
      end

    set_github_release(
      repository_name: ENV["GITHUB_REPOSITORY"],
      api_token: ENV["GITHUB_API_TOKEN"],
      name: tag_name,
      tag_name: tag_name,
      description: full_description,
      commitish: ENV["GITHUB_SHA"],
      is_draft: ENV["FASTLANE_DRAFT_RELEASE"] == "true",
      is_prerelease: ENV["FASTLANE_PRERELEASE"] == "true",
      upload_assets: [signed_apk_path, checksums_path]
    )
  end
end
