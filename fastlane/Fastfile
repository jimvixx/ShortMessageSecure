default_platform(:android)

require "shellwords"
require "base64"
require "digest"

PROJECT_ROOT = File.expand_path("..", __dir__)
ADI_REGISTRATION_FILE = File.join(PROJECT_ROOT, "app/src/main/assets/adi-registration.properties")
EXPECTED_PACKAGE_NAME = "org.jimvixx.smsecure"
EXPECTED_SIGNING_CERT_SHA256 = "FA:3A:00:75:00:6D:56:DD:5E:7B:F9:FA:5F:83:55:63:BF:7D:71:6A:82:19:7A:28:96:17:14:D0:6F:72:AE:01"
EXPECTED_SIGNING_CERT_SHA256_COMPACT = EXPECTED_SIGNING_CERT_SHA256.delete(":").downcase
CHANGELOG_FILE = File.join(PROJECT_ROOT, "CHANGELOG.md")

def changelog_section_for!(tag_name)
  UI.user_error!("Missing #{CHANGELOG_FILE}") unless File.file?(CHANGELOG_FILE)

  lines = File.readlines(CHANGELOG_FILE)
  heading = /^##\s+#{Regexp.escape(tag_name)}(?:\s|$)/

  start_index = lines.index { |line| line.match?(heading) }
  UI.user_error!("Missing CHANGELOG.md section for #{tag_name}") unless start_index

  end_index =
    ((start_index + 1)...lines.length).find do |index|
      lines[index].start_with?("## ")
    end || lines.length

  notes = lines[(start_index + 1)...end_index].join.strip
  UI.user_error!("Empty CHANGELOG.md section for #{tag_name}") if notes.empty?

  notes
end

def decode_keystore!
  keystore_base64 = ENV["ANDROID_KEYSTORE_BASE64"]
  UI.user_error!("Missing ANDROID_KEYSTORE_BASE64") if keystore_base64.to_s.empty?

  File.binwrite("smsecure-release.keystore", Base64.decode64(keystore_base64))
end

def write_keystore_properties!
  store_password = ENV["SIGNING_STORE_PASSWORD"]
  key_alias = ENV["SIGNING_KEY_ALIAS"]
  key_password = ENV["SIGNING_KEY_PASSWORD"]

  UI.user_error!("Missing SIGNING_STORE_PASSWORD") if store_password.to_s.empty?
  UI.user_error!("Missing SIGNING_KEY_ALIAS") if key_alias.to_s.empty?
  UI.user_error!("Missing SIGNING_KEY_PASSWORD") if key_password.to_s.empty?

  File.write("keystore.properties", <<~PROPS)
    storeFile=smsecure-release.keystore
    storePassword=#{store_password}
    keyAlias=#{key_alias}
    keyPassword=#{key_password}
  PROPS
end

def ensure_adi_registration_file!
  unless File.file?(ADI_REGISTRATION_FILE)
    UI.user_error!("Missing #{ADI_REGISTRATION_FILE}. Commit this file to the repository before building a release.")
  end

  if File.read(ADI_REGISTRATION_FILE).strip.empty?
    UI.user_error!("#{ADI_REGISTRATION_FILE} is empty")
  end

  UI.message("Android Developer Verification file found: #{ADI_REGISTRATION_FILE}")
end

def find_unsigned_apk!
  apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]

  UI.message("Gradle APK output: #{apk_path}")

  UI.user_error!("No APK output path returned by Gradle") if apk_path.to_s.empty?
  UI.user_error!("Expected unsigned APK, got: #{apk_path}") unless apk_path.end_with?("-unsigned.apk")

  apk_path
end

def find_latest_build_tools_dir!
  android_home = ENV["ANDROID_HOME"]
  android_sdk_root = ENV["ANDROID_SDK_ROOT"]

  candidates = []

  if !android_home.to_s.empty?
    candidates.concat(Dir.glob(File.join(android_home, "build-tools", "*")))
  end

  if !android_sdk_root.to_s.empty?
    candidates.concat(Dir.glob(File.join(android_sdk_root, "build-tools", "*")))
  end

  build_tools_dir = candidates.uniq.sort.last
  UI.user_error!("Android build-tools not found") if build_tools_dir.to_s.empty?

  build_tools_dir
end

def sign_apk!(unsigned_apk_path)
  build_tools_dir = find_latest_build_tools_dir!

  apksigner = File.join(build_tools_dir, "apksigner")
  zipalign = File.join(build_tools_dir, "zipalign")

  UI.user_error!("apksigner not found at #{apksigner}") unless File.exist?(apksigner)
  UI.user_error!("zipalign not found at #{zipalign}") unless File.exist?(zipalign)

  aligned_apk_path = unsigned_apk_path.sub(/-unsigned\.apk\z/, "-aligned.apk")
  signed_apk_path = unsigned_apk_path.sub(/-unsigned\.apk\z/, ".apk")

  sh(
    "#{zipalign.shellescape} -f -p 4 " \
    "#{unsigned_apk_path.shellescape} " \
    "#{aligned_apk_path.shellescape}"
  )

  sh(
    "#{apksigner.shellescape} sign " \
    "--ks smsecure-release.keystore " \
    "--ks-key-alias #{ENV['SIGNING_KEY_ALIAS'].shellescape} " \
    "--ks-pass env:SIGNING_STORE_PASSWORD " \
    "--key-pass env:SIGNING_KEY_PASSWORD " \
    "--out #{signed_apk_path.shellescape} " \
    "#{aligned_apk_path.shellescape}"
  )

  sh("#{apksigner.shellescape} verify --verbose #{signed_apk_path.shellescape}")

  signed_apk_path
end

def verify_apk_contents!(apk_path, expected_version_name:, expected_version_code:)
  UI.user_error!("APK not found: #{apk_path}") unless File.file?(apk_path)

  build_tools_dir = find_latest_build_tools_dir!
  apksigner = File.join(build_tools_dir, "apksigner")
  aapt = File.join(build_tools_dir, "aapt")

  UI.user_error!("apksigner not found at #{apksigner}") unless File.exist?(apksigner)
  UI.user_error!("aapt not found at #{aapt}") unless File.exist?(aapt)

  sh(
    "unzip -Z1 #{apk_path.shellescape} | " \
    "grep -Fx 'assets/adi-registration.properties'"
  )

  badging_output = sh(
    "#{aapt.shellescape} dump badging #{apk_path.shellescape}",
    log: true
  )

  package_line = badging_output.lines.find { |line| line.start_with?("package:") }
  UI.user_error!("Unable to read APK package metadata") if package_line.to_s.empty?

  actual_package_name = package_line[/\bname='([^']+)'/, 1]
  actual_version_code = package_line[/\bversionCode='([^']+)'/, 1]
  actual_version_name = package_line[/\bversionName='([^']+)'/, 1]

  if actual_package_name != EXPECTED_PACKAGE_NAME
    UI.user_error!(
      "APK package name mismatch. " \
      "Expected #{EXPECTED_PACKAGE_NAME}, got #{actual_package_name || 'unknown'}"
    )
  end

  if actual_version_name != expected_version_name.to_s
    UI.user_error!(
      "APK versionName mismatch. " \
      "Expected #{expected_version_name}, got #{actual_version_name || 'unknown'}"
    )
  end

  if actual_version_code != expected_version_code.to_s
    UI.user_error!(
      "APK versionCode mismatch. " \
      "Expected #{expected_version_code}, got #{actual_version_code || 'unknown'}"
    )
  end

  cert_output = sh(
    "#{apksigner.shellescape} verify --print-certs #{apk_path.shellescape}",
    log: true
  )

  actual_cert_sha256 = cert_output[
    /certificate SHA-256 digest:\s*([0-9a-f:]+)/i,
    1
  ]

  UI.user_error!("Unable to determine APK signing certificate SHA-256") if actual_cert_sha256.to_s.empty?

  actual_cert_sha256_compact = actual_cert_sha256.delete(":").downcase

  unless actual_cert_sha256_compact == EXPECTED_SIGNING_CERT_SHA256_COMPACT
    UI.user_error!(
      "APK signing certificate mismatch. " \
      "Expected SHA-256 #{EXPECTED_SIGNING_CERT_SHA256}, " \
      "got #{actual_cert_sha256}"
    )
  end

  UI.success("APK contains Android Developer Verification file")
  UI.success("APK package name verified: #{EXPECTED_PACKAGE_NAME}")
  UI.success("APK versionName verified: #{actual_version_name}")
  UI.success("APK versionCode verified: #{actual_version_code}")
  UI.success("APK signing certificate verified: #{EXPECTED_SIGNING_CERT_SHA256}")
end

def detect_release_tag!
  if !ENV["MANUAL_TAG_NAME"].to_s.empty?
    ENV["MANUAL_TAG_NAME"]
  elsif ENV["GITHUB_REF_TYPE"] == "tag" && !ENV["GITHUB_REF_NAME"].to_s.empty?
    ENV["GITHUB_REF_NAME"]
  else
    last_git_tag
  end
end

def normalize_apk_name!(signed_apk_path, tag_name)
  final_apk_name = "SMSecure-#{tag_name}.apk"
  final_apk_path = File.join(File.dirname(signed_apk_path), final_apk_name)

  File.delete(final_apk_path) if File.exist?(final_apk_path)
  sh("mv #{signed_apk_path.shellescape} #{final_apk_path.shellescape}")

  final_apk_path
end

def write_sha256_sums!(apk_path)
  apk_dir = File.dirname(apk_path)
  apk_name = File.basename(apk_path)
  sha256 = Digest::SHA256.file(apk_path).hexdigest
  checksums_path = File.join(apk_dir, "SHA256SUMS.txt")

  File.write(checksums_path, "#{sha256}  #{apk_name}\n")

  checksums_path
end

def signing_certificate_sha256
  EXPECTED_SIGNING_CERT_SHA256
end

def build_release_notes(tag_name, checksums_path)
  sha_text = File.read(checksums_path).strip

  <<~NOTES
    ## Downloads

    - `SMSecure-#{tag_name}.apk`
    - `SHA256SUMS.txt`

    ## SHA-256

    ```text
    #{sha_text}
    ```

    ## Verification

    Verify APK checksum:

    ```bash
    sha256sum -c SHA256SUMS.txt
    ```

    Verify signing certificate fingerprint:

    ```bash
    apksigner verify --print-certs SMSecure-#{tag_name}.apk
    ```

    Official signing certificate SHA-256:

    ```text
    #{signing_certificate_sha256}
    ```

    Google Play Protect may warn because SMSecure is distributed outside Google Play.
  NOTES
end

def version_code_from_version_name!(version_name)
  match = version_name.match(
    /\A(\d+)\.(\d+)\.(\d+)(?:[-+][0-9A-Za-z.-]+)?\z/
  )
  UI.user_error!("Invalid versionName: #{version_name}") unless match

  major = match[1].to_i
  minor = match[2].to_i
  patch = match[3].to_i

  UI.user_error!("Minor version must be between 0 and 99") if minor > 99
  UI.user_error!("Patch version must be between 0 and 99") if patch > 99

  version_code = (major * 10_000) + (minor * 100) + patch

  unless version_code.between?(1, 2_100_000_000)
    UI.user_error!(
      "versionCode is outside the supported range: #{version_code}"
    )
  end

  version_code
end

def validate_release_metadata!(tag_name)
  build_gradle = File.join(PROJECT_ROOT, "app/build.gradle.kts")
  contents = File.read(build_gradle)

  version_name_match = contents.match(/val\s+appVersionName\s*=\s*"([^"]+)"/)

  UI.user_error!("Unable to determine versionName") unless version_name_match

  version_name = version_name_match[1]
  version_code = version_code_from_version_name!(version_name)

  unless tag_name.match?(/\Av\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?\z/)
    UI.user_error!("Invalid release tag format: #{tag_name}")
  end

  expected_tag = "v#{version_name}"

  if tag_name != expected_tag
    UI.user_error!(
      "Release tag does not match versionName: " \
      "tag=#{tag_name}, versionName=#{version_name}"
    )
  end

  changelog_path = File.join(
    PROJECT_ROOT,
    "fastlane/metadata/android/en-US/changelogs",
    "#{version_code}.txt"
  )

  unless File.file?(changelog_path)
    UI.user_error!(
      "Missing changelog for versionCode #{version_code}: #{changelog_path}"
    )
  end

  if File.read(changelog_path).strip.empty?
    UI.user_error!(
      "Changelog for versionCode #{version_code} is empty: #{changelog_path}"
    )
  end

  UI.success(
    "Release metadata validated: " \
    "#{tag_name}, versionName=#{version_name}, versionCode=#{version_code}"
  )

  {
    version_name: version_name,
    version_code: version_code,
    changelog_path: changelog_path
  }
end

platform :android do
  desc "CI verification: build debug APK, run unit tests and lint"
  lane :ci do
    gradle(task: "assembleDebug")
    gradle(task: "testDebugUnitTest")
    gradle(task: "lintDebug")
  end

  desc "Build signed release APK, generate SHA256SUMS.txt and publish a GitHub release"
  lane :release do
    sh("git fetch --tags --force")

    tag_name = detect_release_tag!
    release_metadata = validate_release_metadata!(tag_name)

    UI.message(
      "Preparing release #{tag_name}: " \
      "versionName=#{release_metadata[:version_name]}, " \
      "versionCode=#{release_metadata[:version_code]}"
    )

    gradle(task: "testDebugUnitTest")
    gradle(task: "lintDebug")

    ensure_adi_registration_file!
    decode_keystore!
    write_keystore_properties!

    gradle(task: "assembleRelease")

    unsigned_apk_path = find_unsigned_apk!
    signed_apk_path = sign_apk!(unsigned_apk_path)
    verify_apk_contents!(
      signed_apk_path,
      expected_version_name: release_metadata[:version_name],
      expected_version_code: release_metadata[:version_code]
    )

    signed_apk_path = normalize_apk_name!(signed_apk_path, tag_name)
    checksums_path = write_sha256_sums!(signed_apk_path)

    changelog = changelog_section_for!(tag_name)

    release_notes = build_release_notes(tag_name, checksums_path)
    full_description =
      if changelog.empty?
        release_notes
      else
        "#{changelog}\n\n---\n\n#{release_notes}"
      end

    set_github_release(
      repository_name: ENV["GITHUB_REPOSITORY"],
      api_token: ENV["GITHUB_API_TOKEN"],
      name: tag_name,
      tag_name: tag_name,
      description: full_description,
      commitish: ENV["GITHUB_SHA"],
      is_draft: ENV["FASTLANE_DRAFT_RELEASE"] == "true",
      is_prerelease: ENV["FASTLANE_PRERELEASE"] == "true",
      upload_assets: [signed_apk_path, checksums_path]
    )

    UI.success(
      "Release #{tag_name} published successfully: " \
      "versionName=#{release_metadata[:version_name]}, " \
      "versionCode=#{release_metadata[:version_code]}"
    )
  end
end
