<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.jimvixx.smsecure.preferences.widgets.SMSecurePreference
        android:icon="@drawable/ic_smsecure_bw"
        android:key="pref_set_default"
        android:summary="@string/preferences__make_smsecure_the_default_sms_app"
        android:title="@string/preferences__make_default_sms_app"
        app:rightSummaryMaxLines="1" />

    <org.jimvixx.smsecure.preferences.widgets.SMSecureListPreference
        android:key="pref_enter_key_type"
        android:icon="@drawable/ic_keyboard"
        android:title="@string/preferences__keyboard_settings"
        android:summary="@string/preferences__enter_key_summary"
        android:defaultValue="enter"
        android:entries="@array/pref_enter_key_entries"
        android:entryValues="@array/pref_enter_key_values"
        app:rightSummaryMaxLines="2" />

    <org.jimvixx.smsecure.preferences.widgets.SMSecureSwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_clock_digital"
        android:key="pref_show_sent_time"
        android:summary="@string/preferences__show_sent_time_instead_of_received_time_in_conversations"
        android:title="@string/preferences__show_sent_time"
        app:rightSummaryMaxLines="1" />

    <org.jimvixx.smsecure.preferences.widgets.SMSecureSwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_truck_delivery_outline"
        android:key="pref_delivery_report_sms"
        android:summary="@string/preferences__request_a_delivery_report_for_each_sms_message_you_send"
        android:title="@string/preferences__sms_delivery_reports"
        app:rightSummaryMaxLines="1" />

    <org.jimvixx.smsecure.preferences.widgets.SMSecureSwitchPreferenceCompat
        android:dependency="pref_delivery_report_sms"
        android:icon="@drawable/ic_package_variant_closed_check"
        android:key="pref_delivery_report_toast_sms"
        android:summary="@string/preferences__display_a_notification_when_a_delivery_report_is_received"
        android:title="@string/preferences__sms_delivery_reports_notification"
        app:rightSummaryMaxLines="1" />

    <org.jimvixx.smsecure.preferences.widgets.SMSecureSwitchPreferenceCompat
        android:key="pref_always_ask_for_sim_card"
        android:icon="@drawable/ic_sim"
        android:title="@string/preferences__always_ask_for_sim_card"
        android:summary="@string/preferences__always_ask_for_the_sim_card_to_use_when_sending_messages"
        android:defaultValue="true"
        app:rightSummaryMaxLines="1" />

    <org.jimvixx.smsecure.preferences.widgets.SMSecurePreference
        android:key="pref_sim_recovery"
        android:icon="@drawable/ic_sim_alert"
        android:title="@string/preferences__sim_recovery_title"
        android:summary="@string/preferences__sim_recovery_summary" />

</PreferenceScreen>
