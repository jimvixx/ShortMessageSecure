<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permissions_rationale_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_permission_rationale_dialog_corners"
    android:maxWidth="320dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/rationale_icon_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_contacts"
            app:tint="?attr/appColorTextSubtitle" />

        <TextView
            android:id="@+id/rationale_plus_1"
            style="@style/SMSecure.TextAppearance.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="+"
            android:textSize="24sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/rationale_icon_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone"
            app:tint="?attr/appColorTextSubtitle" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        style="@style/SMSecure.TextAppearance.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="0dp"
        android:paddingVertical="10dp"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@+id/header_container"
        app:layout_constraintBottom_toTopOf="@+id/permissions_rationale_negative"
        tools:text="@string/WelcomeActivity_smsecure_needs_access_to_your_contacts_phone_status_and_sms" />

    <Button
        android:id="@+id/permissions_rationale_negative"
        style="@style/Widget.SMSecure.ButtonBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:maxWidth="206dp"
        android:text="@string/Permissions_not_now"
        app:layout_constraintEnd_toStartOf="@id/permissions_rationale_positive"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/message" />

    <Button
        android:id="@+id/permissions_rationale_positive"
        style="@style/Widget.SMSecure.ButtonBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:maxWidth="206dp"
        android:text="@string/Continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/permissions_rationale_negative"
        app:layout_constraintTop_toBottomOf="@id/message" />

</androidx.constraintlayout.widget.ConstraintLayout>
