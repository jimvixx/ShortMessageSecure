<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/log_submit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/log_submit_status"
        style="@style/SMSecure.TextAppearance.Preference.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/log_submit__collecting_logs" />

    <ProgressBar
        android:id="@+id/log_submit_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/log_submit_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/log_submit_preview"
            style="@style/SMSecure.TextAppearance.Preference.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            tools:text="@string/log_submit__thanks" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/log_submit_message_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/log_submit_message_heading"
            style="@style/SMSecure.TextAppearance.Preference.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_submit__message_heading" />

        <TextView
            android:id="@+id/log_submit_message_description"
            style="@style/SMSecure.TextAppearance.Preference.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/log_submit__message_description" />

        <EditText
            android:id="@+id/log_submit_message_input"
            style="@style/SMSecure.TextAppearance.Preference.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog"
            android:gravity="top|start"
            android:hint="@string/log_submit__message_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1024"
            android:maxLines="6"
            android:minLines="3"
            android:paddingHorizontal="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/log_submit_message_status"
            style="@style/SMSecure.TextAppearance.Preference.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            tools:text="@string/log_submit__message_sending"
            tools:visibility="visible" />

        <Button
            android:id="@+id/log_submit_message_button"
            style="@style/Widget.SMSecure.ButtonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:text="@string/log_submit__message_send"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/log_submit_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/log_submit_save_button"
            style="@style/Widget.SMSecure.ButtonBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/log_submit__save_log"
            android:textSize="16sp" />

        <Button
            android:id="@+id/log_submit_share_link_button"
            style="@style/Widget.SMSecure.ButtonBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/log_submit__share_info"
            android:textSize="16sp" />

        <Button
            android:id="@+id/log_submit_share_logs_button"
            style="@style/Widget.SMSecure.ButtonBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/log_submit__button_share_logs"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>